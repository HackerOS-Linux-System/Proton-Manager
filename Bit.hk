[package]
-> name        => proton-manager
-> version     => 0.1.0
-> description => GTK4 + libadwaita tool for Proton and protontricks (with a direct bypass mode).
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => GPL-3.0
-> lang        => h#

[edition]
-> edition   => 2026
-> toolchain => 0.9

[layout]
-> src => src

[build]
-> link => static

[default-build]
-> profile => release
-> emit    => bin

[dependencies]
-> gtk => newest

[system-dependencies]
-> gtk4
--> version => >=4.10
--> pkg-config => gtk4
--> apt => libgtk-4-dev
--> dnf => gtk4-devel
--> pacman => gtk4
--> apk => gtk4.0-dev
--> zypper => gtk4-devel
-> libadwaita
--> version => >=1.5
--> pkg-config => libadwaita-1
--> apt => libadwaita-1-dev
--> dnf => libadwaita-devel
--> pacman => libadwaita
--> apk => libadwaita-dev
--> zypper => libadwaita-devel
-> glib
--> pkg-config => glib-2.0
--> apt => libglib2.0-dev
--> dnf => glib2-devel
--> pacman => glib2
--> apk => glib-dev
--> zypper => glib2-devel

[commands]
-> check
--> run => bit check
--> description => Type-check every module
-> install-local
--> run => install -Dm755 cache/build/release/proton-manager /usr/local/bin/proton-manager && install -Dm644 data/com.protonmanager.App.desktop.in /usr/local/share/applications/com.protonmanager.App.desktop
--> description => Install the release binary and the .desktop file into /usr/local
